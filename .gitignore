# Environment and secrets
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.ty_cache/
.coverage
htmlcov/
docs/build/

# JavaScript
node_modules/
.svelte-kit/
build/
dist/
coverage/
playwright-report/
test-results/
.vercel/
.output/

# Editors and operating systems
.vscode/
.idea/
.DS_Store

# AI coding-agent tooling. Kept on disk, out of the repository: these are
# personal skill libraries rather than anything StudySpot builds, runs or
# tests. .claude/settings.json is the exception and stays tracked -- it is the
# project's own guardrail config, denying `rm -rf`, `git reset --hard` and
# reads of .env for everyone who works here.
.agents/
.claude/skills/
agent.md
claude.md
skills-lock.json

# Notes and drafts that are not part of the project. Untracked but unignored
# is the dangerous combination: `git add -A` sweeps it into a commit.
scratchpad/

# Local tooling
.local/
.direnv/
result
result-*
.vercel
.env*
!.envrc

# Terraform
# .terraform.lock.hcl is deliberately NOT ignored: it pins provider checksums
# and belongs in version control, like uv.lock and bun.lock.
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
terraform.tfvars
!terraform.tfvars.example

# Build artifacts
# `build/` above already covers infra/build/ and src/frontend/build/; these are
# named so that it is obvious they are generated.
infra/build/
src/backend/staticfiles/
