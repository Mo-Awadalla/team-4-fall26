# Local Postgres, as started by `docker compose up postgres`.
DATABASE_URL=postgresql://studyspot:studyspot@localhost:5432/studyspot

# Django refuses to start with DJANGO_DEBUG off and no key. Local development
# falls back to an insecure built-in value, so this is only needed if you turn
# debug off here. Deployments get a generated key from Terraform.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=

# Raises the NYC Open Data rate limit for `just ingest` from the shared
# anonymous pool to a personal one. Free, from
# https://data.cityofnewyork.us/profile/edit/developer_settings. The importer
# runs without it; it never belongs in version control.
NYC_OPEN_DATA_APP_TOKEN=

# Accounts, through Auth0. Leave these blank and the site works without them;
# its log-in controls simply do not appear. docs/source/accounts.md explains
# how to create a tenant. AUTH0_JWKS can stay blank locally: the API fetches the
# keys itself when it has a network.
#
# The domain and client ID below are the team's development tenant. Both are
# public (every browser that logs in sees them), so they are safe to commit;
# the application's client secret is never used and never belongs here.
# Accounts stay off until AUTH0_AUDIENCE is set to the tenant's API identifier.
AUTH0_DOMAIN=dev-8npfy6az4dy3wdtn.us.auth0.com
AUTH0_CLIENT_ID=MwNxZzW2HZXVhB9YSggU2NT0qL6gTigP
AUTH0_AUDIENCE=
AUTH0_JWKS=

# Mount the Django admin. Off in deployments: nothing guards it until the
# backlog reaches accounts.
DJANGO_ENABLE_ADMIN=true

# Which AWS profile the `just aws-*` targets use, for anyone who keeps a
# dedicated profile for this project rather than putting it in `default`. The
# justfile loads this file, so Terraform and the AWS CLI both pick it up.
# Leave it unset to use whatever `aws configure` wrote to the default profile.
# AWS_PROFILE=studyspot
